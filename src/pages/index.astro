---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCategories, getPostSlug, getPublishedPosts, getTags } from '../lib/blog';

const posts = await getPublishedPosts();
const categories = getCategories(posts);
const tags = getTags(posts);
const featured = posts[0];
---

<BaseLayout>
  <section class="home-intro">
    <div>
      <p class="eyebrow">FRANTA Engineering Notes</p>
      <h1>FRANTA技术博客</h1>
      <p>记录不锈钢管道、工艺研发、质量管理与水务工程现场经验。</p>
    </div>
    <div class="intro-stats" aria-label="文章统计">
      <strong>{posts.length}</strong>
      <span>篇技术文章</span>
    </div>
  </section>

  <section class="blog-layout">
    <div class="main-column">
      <div class="section-heading compact-heading">
        <p class="eyebrow">Latest writing</p>
        <h2>最新文章</h2>
      </div>

      <div class="entry-list">
        {posts.map((post) => (
          <article class="post-entry">
            <a href={`/blog/${getPostSlug(post.id)}/`}>
              <div class="entry-date">
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('zh-CN')}
                </time>
                <span>{post.data.category}</span>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <div class="meta-row">
                {post.data.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>

    <aside class="sidebar">
      {featured && (
        <section class="widget">
          <h2>推荐阅读</h2>
          <a class="featured-link" href={`/blog/${getPostSlug(featured.id)}/`}>
            <strong>{featured.data.title}</strong>
            <span>{featured.data.description}</span>
          </a>
        </section>
      )}

      <section class="widget">
        <h2>分类</h2>
        <div class="term-list">
          {categories.map(([category, count]) => (
            <a href={`/categories/${category}/`}>
              <span>{category}</span>
              <em>{count}</em>
            </a>
          ))}
        </div>
      </section>

      <section class="widget">
        <h2>标签</h2>
        <div class="chip-list">
          {tags.map(([tag, count]) => (
            <a href={`/tags/${tag}/`}>{tag}<span>{count}</span></a>
          ))}
        </div>
      </section>
    </aside>
  </section>
</BaseLayout>
